Whisk3D {
    version: 20260724
    Escena {
        fullscreen: false
        fps: 60

        Gamepad {
            name: "Script"
            script: "pong.lua"
            ref_jugador1: "Pala 1"
            ref_jugador2: "Pala 2"
            ref_pelota: "Pelota"
            ref_marcador1: "Marcador 1"
            ref_marcador2: "Marcador 2"
            ref_juego: "Juego"
            ref_mensajeBg: "MensajeBg"
            ref_menuIni: "MenuInicial"
            ref_menuDif: "MenuDificultad"
            ref_mensaje: "Mensaje"
            ref_mi1: "MI1"
            ref_mi2: "MI2"
            ref_mi3: "MI3"
            ref_md1: "MD1"
            ref_md2: "MD2"
            ref_md3: "MD3"
            ref_selMI: "SelMI"
            ref_selMD: "SelMD"
            ref_titMI: "TituloMI"
            ref_titMD: "TituloMD"
            ref_btnPausa: "BtnPausa"
            ref_pausaBar1: "PausaBar1"
            ref_pausaBar2: "PausaBar2"
            ref_dificultad: "normal"
        }

        UI {
            archivo: "pong.w3dui"
        }
    }

    Layout {
        ViewportRow {
            ViewportColumn {
                Editor2D
                Timeline
                Split: 0.8
            }
            ViewportColumn {
                Outliner
                Properties
                Split: 0.4
            }
            Split: 0.72
        }
    }
}
