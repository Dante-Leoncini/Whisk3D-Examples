# ============================================================================
#  Salidas de compilacion del WhiskPaddle. Todo esto se REGENERA; nada de esto
#  va al repo. (En .gitignore un '#' solo comenta al PRINCIPIO de la linea: un
#  comentario al final de una regla la rompe.)
# ============================================================================

# ---- "Compilar juego" (editor Whisk3D): lo generado y los resultados ----
platform-build/
build/

# ---- la plantilla Android (platform/android): lo que deja un build en ella ----
platform/android/libs/
platform/android/obj/
platform/android/.gradle/
platform/android/.cxx/
platform/android/distribution/
platform/android/app/build/
# buildDir real de gradle (build.gradle lo redirige a app/distribution/)
platform/android/app/distribution/
# se copian del juego en cada build
platform/android/app/src/main/assets/
# las .so compiladas por el ndk
platform/android/app/src/main/jniLibs/
# la ruta del SDK (propia de cada maquina)
platform/android/local.properties

# ---- artefactos empaquetados ----
*.apk
*.deb
*.AppImage
