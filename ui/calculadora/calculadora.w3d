{
  "version": 3,
  "icono": "assets/icono.png",
  "escenaInicial": "Calculadora",
  "compilar": {
    "modoVentana": "ventana",
    "orientacion": "vertical",
    "fisica": false,
    "sonido": false,
    "debug": false,
    "assets": "sueltos",
    "plataforma": "linux-deb"
  },
  "paletas": [
    { "nombre": "Whisk3D", "colores": [
      { "nombre": "Fondo", "color": [0.05, 0.05, 0.05, 1] },
      { "nombre": "Blanco", "color": [1, 1, 1, 1] },
      { "nombre": "Accent", "color": [0, 1, 0, 1] },
      { "nombre": "Accent oscuro", "color": [0.4, 0.55, 0, 1] },
      { "nombre": "Negro", "color": [0, 0, 0, 1] },
      { "nombre": "Gris", "color": [0.12, 0.12, 0.12, 1] },
      { "nombre": "Gris UI", "color": [0.75, 0.75, 0.75, 1] },
      { "nombre": "Gris linea", "color": [0.286, 0.286, 0.286, 1] }
    ] }
  ],
  "fps": 60,
  "fullscreen": false,
  "escena": {
    "objetos": [
      {
        "tipo": "ui",
        "archivo": "calculadora.w3dui"
      }
    ]
  },
  "layout": "Layout {\n  ViewportRow {\n    ViewportColumn {\n      Editor2D\n      ViewportColumn {\n        Console\n        Timeline\n        Split: 0.75\n      }\n      Split: 0.627102\n    }\n    ViewportColumn {\n      Outliner\n      Properties\n      Split: 0.4\n    }\n    Split: 0.72\n  }\n}"
}
