# ============================================================================
#  Salidas de compilacion del Calculadora. Todo esto se REGENERA con los scripts de
#  platform/<plataforma>/ ; nada de esto va al repo.
# ============================================================================

# ---- Linux (cmake) ----
platform/linux/build/

# ---- Web (emscripten) ----
platform/web/build/

# ---- Android (ndk-build + gradle) ----
platform/android/libs/
platform/android/obj/
platform/android/.gradle/
platform/android/.cxx/
platform/android/distribution/
platform/android/app/build/
platform/android/app/src/main/assets/     # se copian del juego en cada build
platform/android/app/src/main/jniLibs/     # .so compiladas por el ndk
platform/android/local.properties          # ruta del SDK (propia de cada maquina)

# ---- Compilar juego (editor Whisk3D): lo generado y los resultados ----
platform-build/
build/

# ---- artefactos empaquetados (no se suben al git) ----
*.apk
*.deb
*.AppImage
