<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- El Calculadora lee su UI/lua/tipografia de los ASSETS del APK (no del almacenamiento),
         asi que NO necesita permisos de archivos. -->

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- singleTask + configChanges: rotar/mostrar teclado NO recrea la Activity (con los globals
             estaticos vivos, relanzar main() duplicaria la escena y perderia el contexto GL). SDL maneja el resize. -->
        <!-- una calculadora se usa PARADA: la orientacion queda clavada en vertical
             (mas el hint SDL_HINT_ORIENTATIONS del main.cpp, que le avisa a SDL) -->
        <activity
            android:name=".CalculadoraActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|touchscreen|locale|fontScale"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
